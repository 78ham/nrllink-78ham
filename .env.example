# 复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）。

# ---- 镜像 ----
NRL_IMAGE=ghcr.io/78ham/nrllink:latest

# ---- 后端接口 ----
# 默认只监听本机；要让局域网访问，改成 0.0.0.0（务必在防火墙阻止公网访问）
# 或直接填内网网卡地址，如 192.168.1.10
API_BIND=127.0.0.1
API_PORT=9000

# ---- 设备接入：必须对公网开放 ----
UDP_PORT=60050

# ---- 其他 ----
# JWT 签名密钥：留空则沿用镜像内置配置里的值
TOKEN_KEY=