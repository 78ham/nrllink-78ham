# 复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）。

# ---- 镜像 ----
NRL_IMAGE=ghcr.io/78ham/nrllink:latest

# ---- 后端接口：对局域网开放 ----
# 默认 0.0.0.0 = 所有网卡，局域网可访问。
# ★ 必须确保防火墙 / 安全组没有把 9000 暴露到公网，否则接口会被公网直接访问。
# 只在本机使用可改成 127.0.0.1；只想监听指定内网网卡可填 192.168.1.10。
API_BIND=0.0.0.0
API_PORT=9000

# ---- 设备接入：必须对公网开放，不能走 HTTP 反向代理 ----
UDP_PORT=60050

# ---- 其他 ----
# JWT 签名密钥：留空则沿用镜像内置配置里的值
TOKEN_KEY=