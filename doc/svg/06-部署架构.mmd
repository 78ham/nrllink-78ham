graph TB

    ADMIN["`管理员浏览器
TCP 80（或自备 HTTPS 443）`"]:::clientNode
    LAN["`局域网客户端
后端接口 TCP 9000`"]:::clientNode

    subgraph COMPOSE["Docker Compose（nrllink-web 仓库，同一网络组 nrllink-net）"]
        subgraph WEB["前端容器 web（对公网）"]
            W1["`nginx:1.27-alpine
监听 80`"]:::nginxNode
            W2["`静态文件 / index.html
同源路由 /api /ws /uploads`"]:::svcNode
            W1 --> W2
        end
        subgraph API["后端容器 nrllink（对局域网）"]
            A1["`udphub
监听 9000`"]:::apiNode
            A2["`SQLite /data
上传图片 /www/uploads`"]:::svcNode
            A1 --> A2
        end
        W2 -->|"Docker 网络
服务名 nrllink:9000"| A1
    end

    subgraph DEVICE["终端设备"]
        DEV["`NRL 硬件 / App
UDP 60050`"]:::devNode
    end

    ADMIN -->|"TCP 80"| W1
    LAN -->|"TCP 9000"| A1
    DEV -->|"UDP 60050
（公网直通，不走 HTTP 反代）"| A1

    NOTE["`可选：宿主机再加一层自备反向代理
提供域名 + TLS 证书，指向前端容器 80`"]:::noteNode
    ADMIN -.-> NOTE

    classDef clientNode fill:#2d1b4e,stroke:#a78bfa,stroke-width:2px,color:#ddd6fe
    classDef nginxNode fill:#1a2d0a,stroke:#4ade80,stroke-width:2px,color:#bbf7d0
    classDef apiNode fill:#0d2d5e,stroke:#00d4ff,stroke-width:2px,color:#caf0f8
    classDef svcNode fill:#0d1f35,stroke:#38bdf8,stroke-width:1px,color:#7dd3fc
    classDef devNode fill:#0d3d2d,stroke:#00e5b0,stroke-width:2px,color:#b2f5ea
    classDef noteNode fill:#3d2d0a,stroke:#facc15,stroke-width:1px,color:#fde68a